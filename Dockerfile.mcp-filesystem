# rust-mcp-filesystem container image
#
# Upstream MCP server for filesystem operations, managed by the navra
# gateway. Runs as a separate container or sidecar — never inside the
# agent container.
#
# Build:   podman build -f Dockerfile.mcp-filesystem -t mcp-filesystem:latest .
# Run:     podman run --rm -v /workspace:/workspace:ro mcp-filesystem:latest /workspace

# Builder base digest-pinned 2026-11-18 (rust:1.96-bookworm tag,
# `docker buildx imagetools inspect`); update the digest to pick up
# Rust patch releases / base image refreshes.
FROM rust:1.96-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS builder

WORKDIR /build
# Immutable: rust-mcp-filesystem v0.4.2 (tag) = commit
# 28a1c9448f8fcd9fa555a6613bc1c4f733b3f640 (looked up on GitHub).
# Fetch by commit SHA, not the mutable tag, so the build cannot be
# silently retargeted by a moved tag.
RUN git init . && \
    git remote add origin https://github.com/rust-mcp-stack/rust-mcp-filesystem.git && \
    git fetch --depth 1 origin 28a1c9448f8fcd9fa555a6613bc1c4f733b3f640 && \
    git checkout --detach FETCH_HEAD

ENV RUSTFLAGS="-C target-feature=+crt-static -C strip=symbols"
ENV CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_PANIC=abort
RUN cargo build --release --target x86_64-unknown-linux-gnu

FROM scratch

COPY --from=builder /build/target/x86_64-unknown-linux-gnu/release/rust-mcp-filesystem \
    /usr/local/bin/rust-mcp-filesystem

USER 65534
ENTRYPOINT ["/usr/local/bin/rust-mcp-filesystem"]
