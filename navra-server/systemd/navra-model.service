[Unit]
Description=navra Model Server
PartOf=navra.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/navra model serve --auto
Restart=on-failure
RestartSec=5
Environment=ORT_LIB_PATH=/usr/lib64
Environment=ORT_PREFER_DYNAMIC_LINK=1

# Paths
RuntimeDirectory=navra
ReadWritePaths=%h/.local/share/navra %h/.config/navra %h/.cache/navra

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=navra.target
