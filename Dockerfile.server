# navra-server gateway container image
#
# The navra gateway: MCP server, OpenAI-compatible model proxy (/v1),
# team orchestration, auth/IFC/safety pipeline, and the web UI. Runs
# headless (--no-tray); configure via a mounted config.toml.
#
# Two modes, selected purely by config:
# - Gateway role (default): serves MCP + model proxy + UI. Model
#   inference is external (remote API or a llama.cpp deployment).
# - Kubernetes teammate spawning: set [server] kubernetes_namespace
#   and the gateway spawns teammates as agents.x-k8s.io/v1beta1
#   Sandbox CRs via the bundled kubectl (in-cluster ServiceAccount,
#   see deploy/k8s/rbac.yaml). Requires the kubernetes-sigs/
#   agent-sandbox controller (v1.0+).
#
# No local model runtime (ONNX) in this image — use a llama.cpp
# deployment or a remote model API. Teammate sandboxes run the
# separate navra-agent image.
#
# Build:   podman build -f Dockerfile.server -t navra-server:latest .
# Run:     podman run --rm -p 9315:9315 \
#            -v ./config.toml:/config/config.toml:ro \
#            -v navra-data:/data \
#            navra-server:latest

# Builder base digest-pinned 2026-11-18 (rust:1.96-bookworm tag,
# `docker buildx imagetools inspect`); update the digest to pick up
# Rust patch releases / base image refreshes.
FROM rust:1.96-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS builder

RUN apt-get update && \
    apt-get install -y musl-tools protobuf-compiler && \
    rm -rf /var/lib/apt/lists/*

# kubectl for in-cluster teammate spawning. Match the minor version
# of the target cluster's API server; keep the patch current — the
# Trivy image scan gates on HIGH/CRITICAL CVEs, and older kubectl
# builds carry vulnerable Go stdlib versions.
ARG KUBECTL_VERSION=v1.35.10
ARG TARGETARCH
RUN if [ "${TARGETARCH:-amd64}" != "amd64" ] && [ "${TARGETARCH:-amd64}" != "arm64" ]; then \
        echo "unsupported arch: ${TARGETARCH}"; exit 1; \
    fi && \
    curl -fsSLo /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH:-amd64}/kubectl" && \
    curl -fsSLo /tmp/kubectl.sha256 \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH:-amd64}/kubectl.sha256" && \
    echo "$(cat /tmp/kubectl.sha256)  /usr/local/bin/kubectl" | sha256sum -c - && \
    rm /tmp/kubectl.sha256 && \
    chmod +x /usr/local/bin/kubectl

WORKDIR /src
COPY . .

# Bound cargo parallelism in memory-constrained environments
# (release LTO linking is memory-hungry). Empty = cargo default.
ARG CARGO_JOBS=
ENV CARGO_BUILD_JOBS=${CARGO_JOBS}

# Gateway-only build: no ONNX runtime — model serving is external.
#
# sqlite-vec's C source typedefs from BSD u_intN_t types, which musl
# does not provide (glibc-only assumption upstream). Map them to the
# stdint equivalents — typedef redeclaration to the same type is
# valid C11.
ENV CFLAGS_x86_64_unknown_linux_musl="-Du_int8_t=uint8_t -Du_int16_t=uint16_t -Du_int32_t=uint32_t -Du_int64_t=uint64_t"
ENV RUSTFLAGS="-C target-feature=+crt-static -C strip=symbols"
RUN rustup target add x86_64-unknown-linux-musl && \
    cargo build \
        --profile container \
        --bin navra \
        --target x86_64-unknown-linux-musl \
        --no-default-features

FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY --from=builder \
    /src/target/x86_64-unknown-linux-musl/container/navra \
    /usr/local/bin/navra
COPY --from=builder /usr/local/bin/kubectl /usr/local/bin/kubectl

# Session, audit, knowledge SQLite stores (dirs::data_dir) and the
# Ed25519 signing identity fallback (dirs::config_dir) both resolve
# under HOME/XDG — point them at the persistent volume. A stable
# identity across restarts matters: delegated teammate capability
# tokens chain from it.
ENV HOME=/data
ENV XDG_DATA_HOME=/data
ENV XDG_CONFIG_HOME=/data
VOLUME /data

EXPOSE 9315

USER 65534
ENTRYPOINT ["/usr/local/bin/navra", "mcp", "serve", "--no-tray"]
CMD ["--config", "/config/config.toml"]
